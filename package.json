{
  "name": "vl-design-system",
  "version": "1.0.1",
  "description": "Backgrounds, HeroUI theme tokens, and layout components for VL design system",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "build": "tsc -p tsconfig.build.json && cp assets-base64.json dist/",
    "prepublishOnly": "npm run build",
    "generate-assets": "node scripts/generate-assets-base64.js",
    "generate-theme": "node scripts/generate-heroui-theme.js"
  },
  "keywords": [
    "design-system",
    "backgrounds",
    "heroui",
    "theme",
    "ui",
    "design"
  ],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "@heroui/react": "^3.0.0",
    "motion": "^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@heroui/react": "^3.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.27",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.18.0",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "motion": "^12.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "require": "./dist/theme/index.js"
    },
    "./theme/heroui-theme.css": "./theme/heroui-theme.css",
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js"
    }
  },
  "files": [
    "dist/",
    "theme/heroui-theme.css",
    "assets-base64.json",
    "README.md"
  ]
}
